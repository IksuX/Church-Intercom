# ustawienia i dane serwera (dowiązania do /var/lib/interkom) – nigdy do repozytorium
/.env
/.env.*
/config
/data
*.stare-*
# pliki generowane przez install.sh
livekit/livekit.yaml
caddy/Caddyfile
caddy/sites/*
!caddy/sites/00-przyklad.caddy
# zależności i budowanie
node_modules/
__pycache__/
*.pyc
mobile/ios/
mobile/android/
.DS_Store
zmiany-lokalne-*.patch
# graf wiedzy i pamięć podręczna narzędzia graphify (lokalnie)
graphify-out/
# serwer uruchomiony lokalnie (npm run dev) – ustawienia i dane w app/
app/config/config.json
app/config/secrets.json
app/data/
# podpisywanie aplikacji i klucze – nigdy do repozytorium (repozytorium jest publiczne)
*.p8
*.p12
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
*.xcarchive/
*.ipa
*.aab
*.apk
mobile/build/
mobile/plugins/*/android/build/
